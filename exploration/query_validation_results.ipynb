    "%sql\n",
    "-- Compare the latest primary key results of each validation method, table by table\n",
    "select table_name, method, test_result, null_key_count, duplicate_count\n",
    "from validation_sweep.results.latest_validation_results\n",
    "where test_type = 'pk_integrity'\n",
    "order by table_name, method;"
